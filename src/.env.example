# Application
APP_NAME="Mini RAG App"
APP_VERSION="1.0.0"
APP_ENV=local

# Uploads
FILE_ALLOWED_TYPES=["text/plain", "text/csv", "application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000

# Legacy MongoDB settings retained for configuration compatibility
MONGODB_URI="mongodb://localhost:27017"
MONGODB_NAME="mini-rag"

# PostgreSQL from a host-run FastAPI process
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-postgres"
POSTGRES_DB="mini-rag"

# LLM and embeddings
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="OPENAI"
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_KEY="replace-with-openai-api-key"
OPENAI_API_URL=""
COHERE_API_KEY="replace-with-cohere-api-key"
GENEERATION_MODEL_ID_LITERAL=["gpt-4o-mini", "qwen2.5:3b-instruct-q3_K_S", "qwen2.5:7b-instruct"]
GENEERATION_MODEL_ID="gpt-4o-mini"
EMBEDDING_MODEL_ID="text-embedding-3-small"
EMBEDDING_MODEL_TEMPERATURE=0.1
INPUT_DEFAULT_MAX_CHARACTERS=20000
GENERATION_DEFAULT_MAX_TOKENS=512
EMBEDDING_MODEL_SIZE=1536

# Vector database
VECTOR_DB_BACKEND_LITERAL=["qdrant", "pgvector"]
VECTOR_DB_BACKEND="pgvector"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METRIC_METHOD="Cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=100

# Prompt languages
DEFAULT_LANGUAGE="en"
PRIMARY_LANGUAGE="ar"

# Indexing
INDEX_PAGE_SIZE=10
INDEX_MAX_RETRIES=5
INDEX_BATCH_TIMEOUT_SECONDS=90
INDEX_MAX_BACKOFF_SECONDS=60
INDEX_DELAY_BETWEEN_BATCHES_SECONDS=2

# Celery from a host-run process
CELERY_BROKER_URL="amqp://mini_rag_user:change-me-rabbitmq@127.0.0.1:5672/mini_rag"
CELERY_RESULT_BACKEND="redis://:change-me-redis@127.0.0.1:6379/0"
CELERY_TASK_SERIALIZER="json"
CELERY_RESULT_SERIALIZER="json"
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=2
CELERY_FLOWER_PASSWORD="change-me-flower"

# Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="mini-rag-knowledge-agent"

# Agent memory
AGENT_MEMORY_MAX_MESSAGES=40

# Outbound email (optional). For Gmail, use an App Password rather than the
# account password. Keep SMTP_ENABLED=false until these values are configured.
SMTP_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="sender@example.com"
SMTP_PASSWORD="replace-with-app-password"
SMTP_FROM_ADDRESS="sender@example.com"
SMTP_SECURITY="starttls"
SMTP_TIMEOUT_SECONDS=15
