# Rendered by the official Nginx entrypoint.  Only DEMO_* variables are
# substituted; native Nginx variables such as $host remain intact.

limit_req_zone $binary_remote_addr zone=demo_api:10m rate=${DEMO_API_RATE_LIMIT};
limit_req_zone $binary_remote_addr zone=demo_chat:10m rate=${DEMO_CHAT_RATE_LIMIT};

server {
    listen 80;
    server_name ${DEMO_APP_DOMAIN} ${DEMO_IDP_DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/certbot; }
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DEMO_APP_DOMAIN};

    ssl_certificate ${DEMO_TLS_CERT_PATH};
    ssl_certificate_key ${DEMO_TLS_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size ${DEMO_UPLOAD_MAX_BODY_SIZE};

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        limit_req zone=demo_api burst=20 nodelay;
        proxy_pass http://fastapi:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/api/v1/agents/ {
        limit_req zone=demo_chat burst=4 nodelay;
        proxy_pass http://fastapi:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /docs {
        proxy_pass http://fastapi:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /openapi.json {
        proxy_pass http://fastapi:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /metrics {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
    }

    location ~* \.(?:js|css|woff2?|png|jpg|jpeg|gif|svg|ico)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DEMO_IDP_DOMAIN};

    ssl_certificate ${DEMO_TLS_CERT_PATH};
    ssl_certificate_key ${DEMO_TLS_KEY_PATH};
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Only the browser/OIDC realm and its static resources are public.
    location = /admin {
        return 404;
    }

    location ^~ /admin/ {
        return 404;
    }

    location ^~ /realms/mini-rag/ {
        proxy_pass http://keycloak:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /resources/ {
        proxy_pass http://keycloak:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / { return 404; }
}
