# The index worker has the minimum provider credential necessary to create
# embeddings. Do not add BFF/OIDC, SMTP, or Keycloak administrator credentials.
AUTHZ_ENABLED=true
CELERY_BROKER_URL=amqp://mini_rag_user:replace-with-rabbitmq-password@rabbitmq:5672/mini_rag
CELERY_RESULT_BACKEND=redis://:replace-with-redis-password@redis:6379/0
OPENAI_API_KEY=replace-with-embedding-provider-key
OPENAI_KEY=replace-with-embedding-provider-key
