# Safe public-demo overrides for FastAPI.  Copy this to .env.demo-app.
# OIDC and provider credentials remain in the private .env.app deployment file.
FILE_ALLOWED_TYPES=["application/pdf","text/plain"]
FILE_MAX_SIZE=5
OPENAI_API_KEY=replace-with-provider-key
OPENAI_KEY=replace-with-provider-key
CELERY_BROKER_URL=amqp://mini_rag_demo:replace@rabbitmq:5672/
CELERY_RESULT_BACKEND=redis://:replace@redis:6379/0
AUTH_ENABLED=true
AUTH_MODE=bff_oidc
AUTH_SESSION_REDIS_URL=redis://:replace@redis:6379/1
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_FRONTEND_SUCCESS_URL=https://demo.hebaothman.dev/
AUTH_OIDC_ISSUER=https://id.demo.hebaothman.dev/realms/mini-rag
AUTH_OIDC_CLIENT_ID=mini-rag-bff
AUTH_OIDC_REDIRECT_URI=https://demo.hebaothman.dev/api/v1/auth/callback
DEMO_PUBLIC_MODE=true
DEMO_MAX_PROJECTS_PER_PRINCIPAL=3
# The provisioner creates/resolves this deterministic workspace. No numeric
# project ID is copied into an environment file.
DEMO_PROJECT_MARKER=public-demo-workspace:v1
DEMO_SESSION_IDLE_TIMEOUT_SECONDS=600
DEMO_SESSION_ABSOLUTE_TIMEOUT_SECONDS=1800
DEMO_AGENT_REQUESTS_PER_MINUTE=6
