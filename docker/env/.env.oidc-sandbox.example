# LOCAL DEVELOPMENT ONLY. Keycloak is only an OIDC sandbox; no Keycloak value
# is read by application code. The local app derives a separate Redis database
# from CELERY_RESULT_BACKEND, so no Redis password is duplicated here.
APP_ENV=local
AUTH_ENABLED=true
AUTHZ_ENABLED=true
AUTH_MODE=bff_oidc
AUTH_DEVELOPMENT_MANUAL_TOKEN_ENABLED=false
# Omit this locally to derive Redis database 1 from CELERY_RESULT_BACKEND.
# Production must provide an explicit dedicated URL.
AUTH_SESSION_REDIS_URL=
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=3
AUTH_SESSION_ABSOLUTE_TIMEOUT_SECONDS=20
AUTH_SESSION_COOKIE_NAME=mini_rag_session
AUTH_CSRF_COOKIE_NAME=mini_rag_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
# Loopback HTTP is used only for the automated sandbox test. HTTPS testing is
# documented separately; production must set this to true.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_FRONTEND_SUCCESS_URL=http://127.0.0.1:8000/docs
AUTH_OIDC_ISSUER=https://127.0.0.1:8444/realms/mini-rag
AUTH_OIDC_CLIENT_ID=mini-rag-bff
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
AUTH_OIDC_AUTHORIZATION_ENDPOINT=https://127.0.0.1:8444/realms/mini-rag/protocol/openid-connect/auth
AUTH_OIDC_TOKEN_ENDPOINT=http://keycloak:8080/realms/mini-rag/protocol/openid-connect/token
AUTH_OIDC_JWKS_URL=http://keycloak:8080/realms/mini-rag/protocol/openid-connect/certs
AUTH_OIDC_SCOPES=openid profile email
AUTH_OIDC_ROLES_CLAIM=roles
AUTH_OIDC_ALLOWED_ALGORITHMS=RS256,ES256
AUTH_OIDC_TRANSACTION_TTL_SECONDS=120
