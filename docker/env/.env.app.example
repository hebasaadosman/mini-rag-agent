
APP_NAME="Mini RAG App"
APP_VERSION="1.0.0"
OPENAI_API_KEY=""
FILE_ALLOWED_TYPES=["text/plain", "text/csv", "application/pdf", "application/msword", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=1000

MongoDB_URI="mongodb://admin:admin@localhost:27017"
MONGODB_NAME="mini-rag"

POSTGRES_HOST="pgvector"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="mini-rag"

GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="OPENAI"

OPENAI_KEY=""
# OPENAI_API_URL="http://172.27.176.1:11434/v1"
# OPENAI_API_URL="https://chummy-afraid-electable.ngrok-free.dev/v1"
OPENAI_API_URL=""

COHERE_API_KEY=""

GENEERATION_MODEL_ID_LITERAL=["gpt-4o-mini",  "qwen2.5:3b-instruct-q3_K_S", "qwen2.5:7b-instruct"]
GENEERATION_MODEL_ID=gpt-4o-mini 
# GENEERATION_MODEL_ID="qwen2.5:3b-instruct-q3_K_S"  
# GENEERATION_MODEL_ID="qwen2.5:7b-instruct"  
EMBEDDING_MODEL_ID="text-embedding-3-small"
EMBEDDING_MODEL_TEMPERATURE="0.1"
INPUT_DEFAULT_MAX_CHARACTERS=20000
GENERATION_DEFAULT_MAX_TOKENS=512
EMBEDDING_MODEL_SIZE=1536

VECTOR_DB_BACKEND_LITERAL=["qdrant", "pgvector"]
VECTOR_DB_BACKEND="pgvector"

VECTOR_DB_PATH="qdrant_db"

VECTOR_DB_DISTANCE_METRIC_METHOD="Cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=100

DEFAULT_LANGUAGE="en"
PRIMARY_LANGUAGE="ar"   

INDEX_PAGE_SIZE= 10
INDEX_MAX_RETRIES= 5
INDEX_BATCH_TIMEOUT_SECONDS= 90
INDEX_MAX_BACKOFF_SECONDS= 60
INDEX_DELAY_BETWEEN_BATCHES_SECONDS= 2

# Celery
CELERY_BROKER_URL=amqp://mini_rag_user:password@rabbitmq:5672/mini_rag
CELERY_RESULT_BACKEND=redis://:password@redis:6379/0

CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]

CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=2
CELERY_FLOWER_PASSWORD="replace-with-flower-password"

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=mini-rag-knowledge-agent

# Authentication foundation. Keep disabled until JWT tokens are issued by an
# approved identity provider. Never commit a real AUTH_JWT_SECRET.
AUTH_ENABLED=false
AUTH_JWT_SECRET="replace-with-a-long-random-secret"
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_ISSUER=mini-rag-agent
AUTH_JWT_AUDIENCE=mini-rag-agent-api
AUTH_JWT_LEEWAY_SECONDS=30
AUTHZ_ENABLED=false

# Browser production authentication: generic OIDC/BFF. Do not configure a
# provider-specific integration in code; supply these from private deployment
# configuration. Development bearer tokens require an explicit opt-in.
AUTH_MODE=bff_oidc
AUTH_DEVELOPMENT_MANUAL_TOKEN_ENABLED=false
AUTH_SESSION_REDIS_URL=redis://:password@redis:6379/1
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
AUTH_SESSION_COOKIE_NAME=mini_rag_session
AUTH_CSRF_COOKIE_NAME=mini_rag_csrf
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_FRONTEND_SUCCESS_URL=/
AUTH_OIDC_ISSUER="https://issuer.example.com"
AUTH_OIDC_CLIENT_ID="mini-rag-agent"
AUTH_OIDC_CLIENT_SECRET=""
AUTH_OIDC_REDIRECT_URI="https://app.example.com/api/v1/auth/callback"
AUTH_OIDC_AUTHORIZATION_ENDPOINT="https://issuer.example.com/authorize"
AUTH_OIDC_TOKEN_ENDPOINT="https://issuer.example.com/token"
AUTH_OIDC_JWKS_URL="https://issuer.example.com/.well-known/jwks.json"
AUTH_OIDC_SCOPES="openid profile email"
AUTH_OIDC_ROLES_CLAIM=roles
AUTH_OIDC_ALLOWED_ALGORITHMS="RS256,ES256"
AUTH_OIDC_TRANSACTION_TTL_SECONDS=600

# Outbound email (optional)
SMTP_ENABLED=false
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="sender@example.com"
SMTP_PASSWORD="replace-with-app-password"
SMTP_FROM_ADDRESS="sender@example.com"
SMTP_SECURITY="starttls"
SMTP_TIMEOUT_SECONDS=15
