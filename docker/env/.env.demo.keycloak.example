# Only the Keycloak server reads its own bootstrap and database credentials.
KC_BOOTSTRAP_ADMIN_USERNAME=replace-with-keycloak-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-long-random-keycloak-admin-password
KC_DB=postgres
KC_DB_URL_HOST=pgvector
KC_DB_URL_DATABASE=mini_rag_keycloak
KC_DB_USERNAME=mini_rag_keycloak
KC_DB_PASSWORD=replace-with-long-random-keycloak-db-password
KC_HOSTNAME=https://id.demo.example.com
KC_HEALTH_ENABLED=true
