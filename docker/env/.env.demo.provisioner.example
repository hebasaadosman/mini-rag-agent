# The one-shot provisioner receives only the credentials needed to create the
# public client and limited demo account.
DEMO_APP_DOMAIN=demo.example.com
DEMO_KEYCLOAK_ADMIN_USERNAME=replace-with-keycloak-admin
DEMO_KEYCLOAK_ADMIN_PASSWORD=replace-with-long-random-keycloak-admin-password
DEMO_USER_USERNAME=demo.user
DEMO_USER_PASSWORD=replace-with-long-random-demo-user-password
