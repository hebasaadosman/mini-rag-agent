# PostgreSQL sees only the Keycloak database role it must initialize once on a
# fresh volume. The application database settings remain in .env.postgres.
POSTGRES_HOST=pgvector
POSTGRES_PORT=5432
KC_DB_URL_DATABASE=mini_rag_keycloak
KC_DB_USERNAME=mini_rag_keycloak
KC_DB_PASSWORD=replace-with-long-random-keycloak-db-password
