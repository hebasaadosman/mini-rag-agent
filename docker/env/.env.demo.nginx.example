# Nginx receives domains and rate limits only; it receives no credentials.
DEMO_APP_DOMAIN=demo.example.com
DEMO_IDP_DOMAIN=id.demo.example.com
DEMO_TLS_MODE=bootstrap
DEMO_TLS_CERT_PATH=/etc/nginx/certs/live/demo.example.com/fullchain.pem
DEMO_TLS_KEY_PATH=/etc/nginx/certs/live/demo.example.com/privkey.pem
DEMO_UPLOAD_MAX_BODY_SIZE=5m
DEMO_API_RATE_LIMIT=30r/m
DEMO_CHAT_RATE_LIMIT=2r/m
