# Non-secret settings shared by application containers. Provider, OIDC, SMTP,
# database, and broker secrets belong to service-specific files.
APP_NAME=mini-rag-demo
APP_VERSION=demo
APP_ENV=production
FILE_ALLOWED_TYPES=["text/plain"]
FILE_MAX_SIZE=5
FILE_DEFAULT_CHUNK_SIZE=600
MONGODB_URI=mongodb://unused
MONGODB_NAME=unused
GENERATION_BACKEND=OPENAI
EMBEDDING_BACKEND=OPENAI
OPENAI_API_URL=https://api.openai.com/v1
GENEERATION_MODEL_ID=gpt-4o-mini
EMBEDDING_MODEL_ID=text-embedding-3-small
EMBEDDING_MODEL_TEMPERATURE=0
INPUT_DEFAULT_MAX_CHARACTERS=6000
GENERATION_DEFAULT_MAX_TOKENS=700
EMBEDDING_MODEL_SIZE=1536
VECTOR_DB_BACKEND=pgvector
VECTOR_DB_PATH=unused
VECTOR_DB_DISTANCE_METRIC_METHOD=cosine
DEFAULT_LANGUAGE=en
PRIMARY_LANGUAGE=en
INDEX_PAGE_SIZE=10
INDEX_MAX_RETRIES=3
INDEX_BATCH_TIMEOUT_SECONDS=90
INDEX_MAX_BACKOFF_SECONDS=60
INDEX_DELAY_BETWEEN_BATCHES_SECONDS=1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=1
CELERY_FLOWER_PASSWORD=disabled
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mini-rag-demo
AUTHZ_ENABLED=true
SMTP_ENABLED=false
